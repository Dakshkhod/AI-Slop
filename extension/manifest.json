{
  "manifest_version": 3,
  "name": "TruthLens — AI Slop Detector",
  "short_name": "TruthLens",
  "version": "0.2.0",
  "description": "Automatically badges every image on the page as likely real, likely AI, or inconclusive. Right-click any image for a full forensic report.",
  "permissions": ["contextMenus", "activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TruthLens",
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon-16.png",
      "48":  "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js":  ["content.js"],
      "css": ["content.css", "styles/badge.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icons/icon-16.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "styles/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
