{
  "manifest_version": 3,
  "name": "TruthLens — AI Slop Detector",
  "short_name": "TruthLens",
  "version": "0.1.0",
  "description": "Right-click any image, video, or audio link on the web and inspect it for AI-generated content.",
  "permissions": ["contextMenus", "activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TruthLens",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "48": "icons/icon.svg",
      "128": "icons/icon.svg"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  }
}
