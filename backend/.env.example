# Copy to .env and fill in.

# PostgreSQL connection string (from Neon dashboard)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# All other settings are prefixed TRUTHLENS_
TRUTHLENS_LOG_LEVEL=INFO
TRUTHLENS_ENABLE_ML=true
# Your deployed frontend URL (Vercel) — enables CORS for production
# TRUTHLENS_FRONTEND_URL=https://your-app.vercel.app

# Hugging Face model IDs (overridable). The pipeline degrades gracefully
# when the network or torch is unavailable.
TRUTHLENS_IMAGE_MODEL_ID=Organika/sdxl-detector
TRUTHLENS_AUDIO_MODEL_ID=MelodyMachine/Deepfake-audio-detection-V2

# Device for ML inference: auto | cpu | cuda | mps
TRUTHLENS_DEVICE=auto

# Optional reverse-image search keys (Layer 1)
# TRUTHLENS_GOOGLE_CSE_KEY=
# TRUTHLENS_GOOGLE_CSE_CX=

# Upload limits + pipeline tuning
TRUTHLENS_MAX_UPLOAD_MB=50
TRUTHLENS_VIDEO_FRAME_SAMPLE_RATE=1.0
TRUTHLENS_VIDEO_MAX_FRAMES=60
TRUTHLENS_AUDIO_MAX_SECONDS=60
